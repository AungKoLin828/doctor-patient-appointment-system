{
    "version": 2,
    "builds": [
      { "src": "api/backend/server.js", "use": "@vercel/node" },
      { "src": "src/App.js", "use": "@vercel/static-build" }
    ],
    "routes": [
      { "src": "/api/(.*)", "dest": "/api/backend/server.js" },
      { "src": "/(.*)", "dest": "/src/App.js" }
    ]
  }
  
